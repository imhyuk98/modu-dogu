{
  "name": "modu-friend-inbox",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": { "ALLOWED_ORIGINS": "https://modu-dogu.pages.dev" },
  "d1_databases": [{ "binding": "DB", "database_name": "modu-friend-inbox", "database_id": "4ca95632-3f4a-4198-9b3d-5e73039cbb5e", "migrations_dir": "migrations" }],
  "ratelimits": [
    { "name": "REQUEST_LIMIT", "namespace_id": "2026090801", "simple": { "limit": 120, "period": 60 } },
    { "name": "CREATE_LIMIT", "namespace_id": "2026090802", "simple": { "limit": 10, "period": 60 } }
  ],
  "triggers": { "crons": ["17 * * * *"] }
}
