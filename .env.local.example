# Google Analytics 4 측정 ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google AdSense 게시자 ID (ca-pub-XXXXXXXXXXXXXXXX)
NEXT_PUBLIC_ADSENSE_ID=

# Google 인증 CMP와 지역별 동의 절차를 구성한 경우에만 true
NEXT_PUBLIC_ADSENSE_CERTIFIED_CONSENT=false

# Google AdSense 광고 단위 슬롯 ID (숫자)
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR_BOTTOM=

# 카카오톡 공유 전용 JavaScript 앱 키 (관리자 키/REST API 키 아님)
# 앱의 JavaScript SDK 도메인 및 제품 링크 웹 도메인을 별도로 등록해야 합니다.
NEXT_PUBLIC_KAKAO_JS_KEY=

# 친구 결과함 API (로컬 검사: http://127.0.0.1:8790)
NEXT_PUBLIC_FRIEND_INBOX_API=
